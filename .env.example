# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 브라우저에서 Storage 서명 URL로 업로드할 때 apikey 헤더로 사용 (anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Railway 워커 주소와 공유 비밀값 (워커의 WORKER_SECRET과 같아야 함)
WORKER_URL=http://localhost:8080
WORKER_SECRET=

# 아래 키들은 워커(worker/)에서 사용합니다: FAL_KEY, DEEPSEEK_API_KEY, WHISPER_LANGUAGE, DEEPSEEK_MODEL

# 버튼 잠금 해제 코드와 쿠키 서명용 비밀값
ACCESS_CODE=3233
SESSION_SECRET=change-me-to-a-long-random-string
