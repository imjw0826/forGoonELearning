# Railway Python 워커 서비스의 Variables에 설정합니다.
# 이 파일을 복사하는 것만으로 환경변수가 로드되지는 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_SECRET=
FAL_KEY=
# https://platform.deepseek.com/api_keys 에서 발급한 키 원문만 입력합니다.
# 따옴표나 Bearer 접두사를 넣지 않습니다. Vercel에만 넣으면 워커에 전달되지 않습니다.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WHISPER_LANGUAGE=ko
